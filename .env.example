# Local paths must be absolute. PROJECTS_DIR is mounted at the same path in Docker.
PROJECTS_DIR=/home/you/Projects
UID=1000
GID=1000

PORT=8787
ADMIN_PORT=8788
HOST=127.0.0.1
ADMIN_HOST=127.0.0.1
MCP_TOKEN=
PUBLIC_URL=
AUTH_MODE=both
APPROVAL_MODE=minimal
TOOL_PROFILE=essential

DATA_DIR=/data
WORKSPACE_ROOTS=
DEFAULT_WORKSPACE=
BUILTIN_SKILLS_DIR=./skills
USER_SKILLS_DIR=./data/skills
EXTRA_SKILLS_DIRS=
BUILTIN_COMMANDS_DIR=./commands
USER_COMMANDS_DIR=./data/commands
SHELL_TIMEOUT_MS=120000
SHELL_SYNC_MS=15000
MAX_OUTPUT_BYTES=60000
CHECKPOINTS=true
LOG_LEVEL=info

# Optional: configure a Cloudflare named tunnel for a stable URL.
CLOUDFLARE_TUNNEL_TOKEN=
