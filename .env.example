# Self-hosted MCP server settings. Local paths must be absolute.
# PROJECTS_DIR is mounted at the same path in Docker for any connected MCP client.
PROJECTS_DIR=/home/you/Projects
HOST_UID=1000
HOST_GID=1000
COMPOSE_FILE=compose.yaml
HERDR_BIN=
CHROMIUM_PATH=/usr/local/bin/chromium

PORT=8787
ADMIN_PORT=8788
HOST=127.0.0.1
ADMIN_HOST=127.0.0.1
MCP_TOKEN=
PUBLIC_URL=
AUTH_MODE=both
APPROVAL_MODE=minimal
TOOL_PROFILE=essential

DATA_DIR=/data
WORKSPACE_ROOTS=
DEFAULT_WORKSPACE=
BUILTIN_SKILLS_DIR=./skills
USER_SKILLS_DIR=./data/skills
EXTRA_SKILLS_DIRS=
BUILTIN_COMMANDS_DIR=./commands
USER_COMMANDS_DIR=./data/commands
SHELL_TIMEOUT_MS=120000
SHELL_SYNC_MS=15000
MAX_OUTPUT_BYTES=60000
CHECKPOINTS=true
LOG_LEVEL=info

# Optional: configure a Cloudflare named tunnel for a stable URL.
CLOUDFLARE_TUNNEL_TOKEN=
